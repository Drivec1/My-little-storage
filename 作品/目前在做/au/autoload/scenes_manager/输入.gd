extends Control

# 1. 声明变量（你之前漏掉的部分）
var 用户输入内容: String = ""
@onready var 输入框节点 = self # 【注意】这里换成你场景树里真实的节点名字

func _ready():
	输入框节点.grab_focus()
	输入框节点.text_submitted.connect(_当用户提交)

func _当用户提交(提交的文本: String):
	# 2. 去除首尾空格
	var 清理后的文本 = 提交的文本.strip_edges()
	
	# 3. 如果什么都没输入，直接回车，就无视
	if 清理后的文本 == "":
		return
		
	# 4. 保存到变量（现在不会报错了，因为上面声明过了）
	用户输入内容 = 清理后的文本
	print("已保存用户输入：", 用户输入内容)
	
	# 5. 清空输入框
	输入框节点.text = ""
	
	# 6. 配置打字机
	var 配置 = {
		"字体大小": 20,
		"默认颜色": Color(1, 1, 1),
		"纯文本模式": true 
	}
	
	# 7. 联动打字机
	打字机.开始打印(用户输入内容, 配置)
